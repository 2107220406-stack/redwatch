APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./focus-game.db
APP_TIMEZONE=Asia/Shanghai

VISION_PROVIDER=fake
# For the real OpenAI-compatible gateway:
# VISION_PROVIDER=openai_compatible
# VISION_ENDPOINT=https://api.openai-next.com
# VISION_MODEL=gpt-4o-mini
# VISION_API_KEY=replace-with-a-new-key
VISION_MODEL=fake-model
VISION_ENDPOINT=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=20
MAX_IMAGE_BYTES=5242880
EVIDENCE_RETENTION_DAYS=7

AUTH_MODE=header
AUTH_SECRET=development-only-change-me
INTERNAL_API_TOKEN=development-internal-token
ALLOW_CLIENT_OBSERVATION=
AUTO_CREATE_SCHEMA=

# Production notes:
# - Set APP_ENV=production.
# - Use AUTH_MODE=hmac unless an upstream gateway replaces app auth.
# - AUTH_SECRET and INTERNAL_API_TOKEN must each be at least 32 characters.
# - VISION_PROVIDER=fake is rejected in production.
# - Run `uv run alembic upgrade head`; production does not auto-create schema by default.
